{
  "info": {
    "_postman_id": "d3c1a9a0-1e4a-4f2e-9c3a-soydee-api-collection",
    "name": "Soy-Dee API",
    "description": "RESTful JSON API for the Health Tracking Web App (Go + MySQL). Import together with the \"Soy-Dee API - Local\" environment. Run requests inside a folder top-to-bottom on first use: login requests auto-save tokens/ids, and POST (create) requests auto-save the new record id into environment variables used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login - Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('member_token', json.data.token);",
                  "    pm.environment.set('member_refresh_token', json.data.refresh_token);",
                  "    pm.environment.set('member_id', json.data.member.mb_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{member_username}}\",\n  \"password\": \"{{member_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/member",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "member"]
            }
          }
        },
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('admin_token', json.data.token);",
                  "    pm.environment.set('admin_refresh_token', json.data.refresh_token);",
                  "    pm.environment.set('admin_id', json.data.admin.sys_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sys_username\": \"{{admin_username}}\",\n  \"sys_password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/admin",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "admin"]
            }
          }
        },
        {
          "name": "Register (Member)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mb_user_name\": \"{{member_username}}\",\n  \"mb_password\": \"{{member_password}}\",\n  \"mb_full_name\": \"สมชาย ใจดี\",\n  \"mb_gender\": 1,\n  \"mb_birth_date\": \"1998-08-08\",\n  \"body_stats\": {\n    \"mbs_weight\": 68.5,\n    \"mbs_height\": 172.0,\n    \"mbs_activity_level\": 1.55,\n    \"mbs_target\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Refresh Token (Member)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('member_token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{member_refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout (Member)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{member_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
